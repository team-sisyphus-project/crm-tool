# Atomic CRM environment variables
#
# Copy this file to `.env.development.local` (local dev) or `.env.production.local`
# (production build) and fill in the values. Every browser-exposed variable is
# prefixed with `VITE_` so Vite inlines it into the built bundle at build time.
#
# ---------------------------------------------------------------------------
# REQUIRED — the app cannot connect to its backend without these two.
# They have NO default: if either is missing at build time the app renders a
# configuration-required screen instead of the CRM.
#
# Where each preview/run mode gets these two values (`import.meta.env` is
# inlined at build time, so the source depends on how the bundle is built):
#
#   1. Dev server, real backend — `npm run dev` (vite.config.ts).
#      NODE_ENV=development, so the config's `define` block is OFF and Vite
#      auto-loads `.env.development` (committed, points at local Supabase).
#      Both values come from there.
#
#   2. Demo — `npm run dev:demo` / `npm run build:demo` (vite.demo.config.ts).
#      Its `define` ALWAYS injects both values, falling back to
#      `https://demo.example.org` when `process.env` is unset, and forces
#      VITE_IS_DEMO=true. This mode is never blank.
#
#   3. Production build in CI — `npm run build` (vite.config.ts) in the
#      `deploy-supabase` job of `.github/workflows/deploy.yml`. There
#      NODE_ENV=production AND `process.env.VITE_SUPABASE_URL` is set (from the
#      `SUPABASE_URL` / `SB_PUBLISHABLE_KEY` GitHub repository secrets), so the
#      config's `define` block inlines those secret values into the bundle.
#
#   4. Production build outside CI — `npm run build` (vite.config.ts) with no
#      secrets in the environment. NODE_ENV=production but
#      `process.env.VITE_SUPABASE_URL` is unset, so the `define` block is OFF
#      and Vite falls back to auto-loading `.env.production.local`
#      (`.env.production` / `.env.production.local` are gitignored). Create that
#      file (copy this one) or export the two VITE_ vars into the shell.
#
#      GAP: a non-CI `npm run build` + `npm run preview` with neither
#      `process.env` secrets NOR a `.env.production.local` ships a bundle where
#      both required vars are empty — the app then shows the configuration-
#      required screen. This is the common cause of a blank preview.
#
#      To preview WITHOUT wiring a real backend, use `npm run preview:demo`
#      (build:demo + preview). The demo config's `define` block always injects
#      both required values (falling back to `https://demo.example.org`) and
#      forces VITE_IS_DEMO=true, so that preview runs on in-browser fake data
#      and can never be blank. To preview against a REAL backend instead,
#      supply the two values below via a `.env.production.local` (copy of this
#      file) or by exporting them into the shell, then run `npm run build`
#      followed by `npm run preview`.
#
# See doc/developers/deploy for details.
# ---------------------------------------------------------------------------

# URL of your Supabase instance (e.g. https://<project-ref>.supabase.co).
VITE_SUPABASE_URL=

# Supabase publishable (anon) key. See
# https://supabase.com/docs/guides/api/api-keys#where-to-find-keys
VITE_SB_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# OPTIONAL — each has a safe built-in fallback; leave unset to use the default.
# ---------------------------------------------------------------------------

# Run the app against in-browser fake data instead of Supabase. Default: false.
VITE_IS_DEMO=false

# Inbound email address (Postmark) shown in Settings. Unset hides the feature.
VITE_INBOUND_EMAIL=

# Storage bucket used for attachments. Default: attachments.
VITE_ATTACHMENTS_BUCKET=attachments

# Disable the email/password login form (leave only SSO). Default: false.
VITE_DISABLE_EMAIL_PASSWORD_AUTHENTICATION=false

# Restrict Google SSO to a single Workspace domain. Unset allows any domain.
VITE_GOOGLE_WORKPLACE_DOMAIN=

# ---------------------------------------------------------------------------
# RUNTIME (server-side) — read by `node server.mjs` and by the migration/seed
# scripts, NOT by the browser bundle. These are deliberately un-prefixed: only
# `VITE_`-prefixed variables are inlined into the built assets, so nothing
# below can leak into the client. The hosting platform injects them; every one
# has a working local default, so a green-field `npm run build:demo && npm
# start` needs none of them.
#
# NEVER put a real value in this file — it is committed. Copy it to an
# untracked `.env.production.local` (or export into the shell) and fill it in
# there.
# ---------------------------------------------------------------------------

# Port the app server listens on. Injected by the platform; never hardcode a
# port anywhere else. Default: 3000.
PORT=3000

# Interface to bind. Default: 0.0.0.0 (required inside a container).
HOST=0.0.0.0

# Directory holding the build output the server hands out. Default: dist.
STATIC_ROOT=dist

# PostgreSQL connection string, injected by the platform
# (postgresql://user:password@host:port/database). Consumed by the migration
# and seed scripts, never by the browser bundle. Unset locally means "use the
# local Supabase stack" (`make start`), whose URL comes from supabase/config.toml.
DATABASE_URL=

# Redis connection string, injected by the platform (redis://host:port). Unset
# means no cache layer; the app runs without one.
REDIS_URL=
